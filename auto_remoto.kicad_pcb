	(gr_text "PONCHO AUTO REMOTO - una cara (cobre abajo, B.Cu) - planchado de toner\nReglas catedra: agujeros 0,7 mm, pistas y separacion >= 0,6 mm, paso 2,54 mm.\nMechas: R/C/CI 0,75 - tiras de pines 1 - borneras 1,25-1,5 - tornillos 3,25 mm.\nImprimir B.Cu + Edge.Cuts a escala 1:1, SIN espejar."
		(at 172.94 36.82 0)
		(layer "Cmts.User")
		(uuid "9e8bd273-4264-4309-a102-a9eacaeb8a75")
		(effects
